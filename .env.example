APP_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1
# Required in production: private Redis URL, or rediss:// for external connections.
REDIS_URL=
# Generate at least 32 random characters; keep this value private.
RATE_LIMIT_SALT=
# Leave unset unless the actual trusted proxy ranges are verified.
TRUSTED_PROXY_CIDRS=
# Set true after completing the public calculator checklist in LAUNCH_SETUP.md.
LAUNCH_SETTINGS_REVIEWED=false
