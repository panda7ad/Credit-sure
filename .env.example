SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Server only: never put this in HTML, JS, public config, or Git.
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
APP_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1
# Required in production; use a private network or rediss:// for external Redis.
REDIS_URL=
RATE_LIMIT_SALT=
TRUSTED_PROXY_CIDRS=
# Public Turnstile site key. Enable Turnstile in Supabase Auth with its secret key.
TURNSTILE_SITE_KEY=
PUBLIC_SIGNUP_ENABLED=false
# Set true ONLY after completing LAUNCH_SETUP.md provider checks.
LAUNCH_SETTINGS_REVIEWED=false
